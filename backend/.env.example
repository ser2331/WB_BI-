# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Database (SQLite for local dev)
DATABASE_URL=sqlite+aiosqlite:///./wb_bi.db

# CORS (для Render добавьте URL GitHub Pages)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Mock mode (локальная разработка без WB)
MOCK_WB=true
AUTO_SEED_MOCK=true

# Auth (логин/пароль в .env, без БД пользователей)
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRE_MINUTES=10080
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
USER_USERNAME=user
USER_PASSWORD=user
